# LINE Messaging API設定
LINE_CHANNEL_ACCESS_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET_HERE

# Claude API設定
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Supabase設定
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

# ココナラ連携（有料鑑定の導線）
# ジャンル別（推奨）。未設定のジャンルは下記 COCONALA_URL をフォールバックとして使います。
COCONALA_URL_RENAI=https://coconala.com/services/xxxxxxxx
COCONALA_URL_ZAIU=https://coconala.com/services/xxxxxxxx
COCONALA_URL_SHIGOTO=https://coconala.com/services/xxxxxxxx
COCONALA_URL_SOUGOU=https://coconala.com/services/xxxxxxxx
COCONALA_URL_KOTOSHI=https://coconala.com/services/xxxxxxxx
# 1本だけ先に出す場合はこれだけでも可（全ジャンル・または未設定分の共通URL）
COCONALA_URL=https://coconala.com/services/xxxxxxxx
# 恋愛のみ別名で置きたい場合: COCONALA_URL_LOVE も可

# Stripe（レガシー。Webhook は ENABLE_STRIPE_WEBHOOK=true のときのみ有効）
# ENABLE_STRIPE_WEBHOOK=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# PayJP（審査後に追加予定の場合、別途実装と合わせて設定）
# PAYJP_SECRET_KEY=
# PAYJP_WEBHOOK_SECRET=

# サーバー設定
PORT=3000
NODE_ENV=development

# 有料版設定
PAID_FORTUNE_PRICE_JPY=1000
